<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <!-- Keep the familiar output folder (bin\<config>\net8.0-windows) although the TFM now carries the Windows SDK version. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AudioBridgeServer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.1.40" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Native libusb-1.0.dll for the USB (Android Open Accessory) host; UsbDk backend preferred. -->
    <PackageReference Include="libusb.runtime" Version="1.0.27" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

</Project>
